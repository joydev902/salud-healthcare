# Copy to .env to override defaults. Every value below is a safe local default,
# so the app also runs without a .env file. Never commit real secrets.

# --- Backend (FastAPI) ---
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/salud_mra
# Tests use TEST_DATABASE_URL, or DATABASE_URL with the database renamed to salud_mra_test
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/salud_mra_test
DATABASE_ECHO=false
# Required (>= 32 chars) whenever ENVIRONMENT is not local/test
JWT_SECRET=local-dev-only-insecure-jwt-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_BYTES=10485760
# Password for the seeded demo accounts (synthetic data only)
SEED_DEMO_PASSWORD=Password123!

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=salud_mra

# --- Frontend (Vite) ---
API_PROXY_TARGET=http://127.0.0.1:8000
